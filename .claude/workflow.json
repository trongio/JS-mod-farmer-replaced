{
  "$schema": "https://raw.githubusercontent.com/trongio/claude-workflow/main/schema/workflow.schema.json",
  "idPrefix": "JMFR",
  "baseBranch": "main",
  "wipLimit": 2,
  "milestone": {
    "label": "v1"
  },
  "gates": [
    {
      "name": "build",
      "cmd": "PATH=$HOME/.dotnet:$PATH dotnet build src/JsMod/JsMod.csproj -c Release -nologo -v q",
      "when": [
        "src/",
        "Directory.Build.props",
        "nuget.config"
      ]
    },
    {
      "name": "test",
      "cmd": "PATH=$HOME/.dotnet:$PATH dotnet test tests/JsMod.Tests -nologo",
      "when": [
        "src/",
        "tests/",
        "Directory.Build.props",
        "nuget.config"
      ]
    }
  ],
  "worktree": {
    "link": [],
    "copy": [],
    "setup": []
  },
  "ui": false,
  "docs": {
    "design": []
  },
  "risk": {
    "high": [
      "src/JsMod/Patches/LeaderboardPatches.cs"
    ]
  },
  "overnight": {
    "parallel": 2,
    "model": "opus"
  },
  "push": false
}
